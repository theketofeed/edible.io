# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  EDIBLE.IO ENVIRONMENT SETUP                                             ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# This template shows all required environment variables for Edible.io.
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local
# 2. Fill in your actual API keys
# 3. Restart your dev server (npm run dev)

# ─── CORE API KEYS ─────────────────────────────────────────────────────────
VITE_CLAUDE_API_KEY=sk-ant-...
VITE_GROQ_API_KEY=gsk_...
VITE_OCR_SPACE_API_KEY=your_ocr_space_key

# ─── SUPABASE ──────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...
VITE_SUPABASE_SERVICE_KEY=eyJhbGc...

# ─── DODO PAYMENTS ────────────────────────────────────────────────────────
DODO_API_KEY=sk_test_...
DODO_ENV=test_mode
DODO_WEBHOOK_SECRET=whsec_...
DODO_PRODUCT_PRO_MONTHLY=pdt_...
DODO_PRODUCT_PRO_ANNUAL=pdt_...
DODO_PRODUCT_FOUNDING=pdt_...

# ─── FRONTEND ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:3001

# ─── PostHog Analytics ─────────────────────────────────────────────────────
VITE_POSTHOG_TOKEN=your_posthog_token
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Meal Image Pipeline (server-side only — do NOT prefix with VITE_) ─────
# Pexels: https://www.pexels.com/api/ (free tier: 200 req/hr)
PEXELS_API_KEY=your_pexels_api_key

# Pixabay: https://pixabay.com/api/docs/ (free tier: 5000 req/day)
# Images are re-hosted to Supabase Storage (Pixabay prohibits hotlinking)
PIXABAY_API_KEY=your_pixabay_api_key

# Wikimedia Commons: no API key required

# ─── Supabase Storage ──────────────────────────────────────────────────────
# Create a public bucket named 'meal-images' in Supabase Dashboard > Storage
# (Pixabay images are re-uploaded here to comply with their terms)

# ═══════════════════════════════════════════════════════════════════════════
# DEPLOYMENT NOTE:
# When deploying to production:
# - Keep these same env vars but update with production values
# - Make sure VITE_BACKEND_URL points to your production backend
# - Frontend vars are exposed (safe to expose public keys)
# - Backend vars (PEXELS_API_KEY, PIXABAY_API_KEY) stay secure on server only
# ═══════════════════════════════════════════════════════════════════════════
